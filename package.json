{
  "name": "revuelto-assembly",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "assets": "node tools/prepare-model.mjs",
    "optimize": "node tools/optimize-assets.mjs",
    "predev": "npm run assets && npm run optimize",
    "dev": "next dev",
    "prebuild": "npm run assets && npm run optimize && npm test && npm run verify:headlights && npm run verify:cabin",
    "build": "next build",
    "build:vercel": "npm run prebuild && next build",
    "postbuild": "node tools/review-browser.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:headlights": "node tools/verify-headlights.mjs",
    "verify:cabin": "node tools/verify-cabin.mjs",
    "verify:browser": "node tools/verify-browser.mjs",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "dependencies": { "gsap": "3.13.0", "next": "16.3.5", "react": "^19.2.0", "react-dom": "^19.2.0", "three": "0.186.0" },
  "devDependencies": {
    "@types/node": "^22.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "typescript": "^5.9.3",
    "@gltf-transform/core": "4.2.1", "@gltf-transform/extensions": "4.2.1", "@gltf-transform/functions": "4.2.1",
    "meshoptimizer": "0.24.0", "sharp": "0.34.3", "puppeteer-core": "24.14.0", "@sparticuz/chromium": "138.0.2"
  }
}
